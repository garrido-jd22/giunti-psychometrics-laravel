// Home (bloques: hero, hero-feature, featured, contact, contact-form)

// Hero: grid de 3 filas. En desktop el vídeo ocupa las filas 1-2 y las
// tarjetas las 2-3, así que quedan a mitad sobre el vídeo.
.hero
  position: relative
  display: grid
  grid-template-columns: minmax(0, 1fr)
  grid-template-rows: auto 1fr 1fr
  background-color: $color-white
  transition: background-color $duration-base $ease-default

  +dark()
    background-color: $color-night

  &__media
    position: relative
    grid-column: 1
    grid-row: 1 / 2
    overflow: hidden
    border-radius: 0 0 $radius-hero $radius-hero
    background-color: $color-mist
    transition: background-color $duration-base $ease-default

    +lg()
      grid-row: 1 / 3

    +dark()
      background-color: $color-night

  &__video
    position: absolute
    inset: 0
    width: 100%
    height: 100%
    object-fit: cover
    pointer-events: none

  &__overlay
    position: absolute
    inset: 0
    background-color: rgba($color-mist, .55)

    +dark()
      background-color: rgba($color-night, .65)

  &__content
    position: relative
    z-index: z('raised')
    grid-column: 1
    grid-row: 1
    display: flex
    flex-direction: column
    align-items: center
    justify-content: center
    width: 100%
    max-width: 980px
    min-height: 520px
    margin-inline: auto
    padding: 128px $container-gutter $space-12
    text-align: center

    +sm()
      min-height: 600px
      padding-inline: $container-gutter-sm
      padding-bottom: $space-16

  &__badge
    display: inline-flex
    align-items: center
    gap: 10px
    margin-bottom: 28px
    padding: 6px 14px
    border-radius: $radius-full
    border: 1px solid rgba($color-navy, .15)
    glass($color-white, .85, 8px)
    box-shadow: $shadow-xs

    +dark()
      border-color: rgba($color-mist, .15)
      background-color: rgba($color-night, .8)

  // Avatares superpuestos
  &__avatars
    display: flex

    > * + *
      margin-left: -8px

  &__avatar
    flex-center()
    square(24px)
    border-radius: $radius-full
    font-size: 11px
    font-weight: $font-weight-bold
    ring($color-white)

    +dark()
      ring($color-night)

    &--navy
      background-color: $color-navy
      color: $color-white

    &--sky
      background-color: $color-sky
      color: $color-white

    &--ink
      background-color: $color-ink
      color: $color-mist

  &__badge-text
    font-size: 14px
    font-weight: $font-weight-semibold
    text-ink()

  &__title
    margin-bottom: $space-5
    font-size: 36px
    font-weight: $font-weight-medium
    letter-spacing: $letter-spacing-tighter
    line-height: 1.08
    text-ink()
    animation-delay(120ms)

    +sm()
      font-size: 60px

    +md()
      font-size: 68px

  &__subtitle
    max-width: 640px
    margin: 0 auto $space-5
    font-size: 17px
    text-ink(.85)
    animation-delay(300ms)

    +sm()
      font-size: 18px

  &__cta
    margin-top: $space-1
    animation-delay(450ms)

  &__button
    height: 44px
    padding-inline: 28px
    color: $color-mist
    font-size: 15.5px
    font-weight: $font-weight-medium
    box-shadow: $shadow-sm

  &__features
    position: relative
    z-index: z('overlap')
    grid-column: 1
    grid-row: 2 / 4
    margin-top: $space-6
    padding-inline: $container-gutter

    +sm()
      margin-top: $space-8
      padding-inline: $container-gutter-sm

    +lg()
      margin-top: 0

  &__features-list
    display: grid
    grid-template-columns: repeat(2, minmax(0, 1fr))
    gap: $space-3
    max-width: $container-max-width
    margin-inline: auto

    +sm()
      gap: $space-4

    +lg()
      grid-template-columns: repeat(4, minmax(0, 1fr))

// Tarjeta de ventaja bajo el hero
.hero-feature
  display: flex
  flex-direction: column
  align-items: center
  gap: $space-3
  padding: $space-4
  border-radius: $radius-3xl
  text-align: center
  glass($color-white, .9)
  box-shadow: $shadow-feature
  transition: translate $duration-base $ease-default, box-shadow $duration-base $ease-default

  +sm()
    flex-direction: row
    align-items: flex-start
    gap: $space-4
    padding: $space-5
    text-align: left

  &:hover
    translate: 0 -4px
    box-shadow: $shadow-feature-hover

  +dark()
    background-color: rgba($color-surface-dark, .9)
    box-shadow: $shadow-feature-dark

    &:hover
      box-shadow: $shadow-feature-hover

  &__icon
    flex-center()
    flex-shrink: 0
    square(44px)
    border-radius: $radius-2xl
    background-color: rgba($color-sky, .12)
    color: $color-navy
    transition: $transition-colors
    transition-duration: $duration-base

    +sm()
      square(48px)

    +dark()
      background-color: rgba($color-sky, .15)
      color: $color-sky

    .icon
      square(20px)

      +sm()
        square(22px)

  &:hover &__icon
    background-color: $color-navy
    color: $color-white

  &__text
    min-width: 0

  &__title
    font-size: 14.5px
    font-weight: $font-weight-semibold
    letter-spacing: $letter-spacing-tight
    line-height: $line-height-snug
    text-ink()

    +sm()
      font-size: 15.5px

  &__description
    margin-top: 2px
    font-size: 12.5px
    line-height: $line-height-snug
    text-ink(.6)

    +sm()
      font-size: 13.5px

// Hover de la tarjeta sobre el icono, en oscuro
html.dark .hero-feature:hover .hero-feature__icon
  background-color: $color-sky
  color: $color-night

// Productos destacados
.featured
  width: 100%
  padding: $space-20 $container-gutter
  surface-section()

  +sm()
    padding-inline: $container-gutter-sm

  &__header
    display: flex
    flex-direction: column
    justify-content: space-between
    gap: $space-4
    margin-bottom: $space-12

    +md()
      flex-direction: row
      align-items: flex-end

  &__eyebrow
    display: inline-block
    margin-bottom: $space-3
    padding: $space-1 14px
    border-radius: $radius-full
    background-color: rgba($color-sky, .15)
    font-size: 13.5px
    font-weight: $font-weight-semibold
    text-accent()

    +dark()
      background-color: rgba($color-sky, .2)

  &__title
    font-size: 30px
    line-height: 36px
    font-weight: $font-weight-semibold
    letter-spacing: $letter-spacing-tight
    text-ink()

    +sm()
      font-size: 36px
      line-height: 40px

  &__link
    display: inline-flex
    align-items: center
    gap: $space-2
    font-size: 15.5px
    font-weight: $font-weight-semibold
    color: $color-navy
    transition: $transition-colors

    &:hover
      color: $color-sky

    +dark()
      color: $color-sky

      &:hover
        color: $color-mist

    .icon
      square(16px)

// Contacto
.contact
  width: 100%
  padding: $space-16 $container-gutter
  scroll-margin-top: $header-offset
  surface-section()

  +sm()
    padding: $space-20 $container-gutter-sm

  &__grid
    display: grid
    grid-template-columns: minmax(0, 1fr)
    align-items: start
    gap: $space-12

    +lg()
      grid-template-columns: repeat(12, minmax(0, 1fr))
      gap: $space-10

  &__intro
    display: flex
    flex-direction: column
    align-items: flex-start

    +lg()
      grid-column: span 5

  &__panel-wrapper
    animation-delay(150ms)

    +lg()
      grid-column: span 7

  &__title
    font-size: 36px
    font-weight: $font-weight-semibold
    letter-spacing: $letter-spacing-tighter
    line-height: 1.06
    text-ink()

    +sm()
      font-size: 48px

    +md()
      font-size: 56px

  &__dash
    text-accent()

  &__text
    max-width: 430px
    margin-top: $space-5
    font-size: 14.5px
    line-height: 1.65
    text-ink(.8)

  &__details
    margin-top: $space-8

    > * + *
      margin-top: $space-5

  &__label
    display: block
    margin-bottom: $space-1
    font-size: 12.5px
    font-weight: $font-weight-medium
    text-ink(.6)

  &__value
    font-size: 19px
    font-weight: $font-weight-semibold
    letter-spacing: $letter-spacing-tight
    color: $color-ink
    transition: $transition-colors

    +sm()
      font-size: 21px

    &:hover
      color: $color-sky

    +dark()
      color: $color-mist

      &:hover
        color: $color-sky

    &--block
      display: block

  &__hours
    display: block
    margin-top: $space-1
    font-size: 12px
    text-ink(.6)

  &__panel
    position: relative
    overflow: hidden
    padding: $space-6
    border-radius: $radius-panel
    glass-card(.85, .85)
    box-shadow: $shadow-panel

    +sm()
      padding: 36px

    +dark()
      box-shadow: $shadow-panel-dark

  // Resplandor radial solo en tema oscuro
  &__glow
    position: absolute
    bottom: -96px
    left: -96px
    display: none
    square(520px)
    border-radius: $radius-full
    background: radial-gradient(circle, rgba(56, 189, 248, .55) 0%, rgba(14, 165, 233, .30) 35%, rgba(125, 211, 252, .12) 55%, transparent 72%)
    filter: blur(40px)
    pointer-events: none

    +dark()
      display: block

// flex + gap en lugar de márgenes: el input oculto de @csrf no suma espacio
.contact-form
  position: relative
  z-index: z('raised')
  display: flex
  flex-direction: column
  gap: $space-5

  &__row
    display: grid
    grid-template-columns: minmax(0, 1fr)
    gap: $space-4

    +sm()
      grid-template-columns: repeat(2, minmax(0, 1fr))

  &__footer
    display: flex
    flex-direction: column
    justify-content: space-between
    gap: $space-4
    padding-top: $space-2

    +sm()
      flex-direction: row
      align-items: center

  &__success
    display: inline-flex
    align-items: center
    gap: $space-2
    padding: $space-2 14px
    border-radius: $radius-2xl
    background-color: $color-emerald-50
    color: $color-emerald-700
    font-size: 14px
    font-weight: $font-weight-semibold

    +dark()
      background-color: rgba($color-emerald-400, .1)
      color: $color-emerald-300

  &__note
    font-size: 13px
    text-ink(.6)

  &__submit
    display: inline-flex
    align-items: center
    justify-content: center
    align-self: flex-end
    gap: $space-3
    height: 44px
    padding-left: $space-6
    padding-right: $space-2
    border-radius: $radius-full
    background-color: $color-navy
    color: $color-white
    font-size: 15px
    font-weight: $font-weight-semibold
    box-shadow: $shadow-sm
    transition: $transition-colors

    &:hover
      background-color: $color-sky

    &:disabled
      opacity: .7
      cursor: wait

    &--success
      background-color: $color-emerald-600

      &:hover
        background-color: $color-emerald-500

  &__submit-icon
    flex-center()
    square(28px)
    border-radius: $radius-full
    background-color: rgba($color-white, .15)

  // Un icono por estado: idle (flecha), loading (spinner), success (check)
  .icon.contact-form__state-icon
    square(14px)

    &--loading,
    &--success
      display: none

  &__submit--loading .icon.contact-form__state-icon--idle,
  &__submit--success .icon.contact-form__state-icon--idle
    display: none

  &__submit--loading .icon.contact-form__state-icon--loading,
  &__submit--success .icon.contact-form__state-icon--success
    display: block
