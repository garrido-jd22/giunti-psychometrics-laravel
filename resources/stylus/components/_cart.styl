// Carrito (bloques: cart-drawer, cart-item)

// Cerrado: sin eventos de puntero
.cart-drawer
  position: fixed
  inset: 0
  z-index: z('drawer')
  pointer-events: none

  &--open
    pointer-events: auto

  &__backdrop
    position: absolute
    inset: 0
    glass($color-night, .45, 2px)
    opacity: 0
    transition: opacity $duration-base $ease-default

  &--open &__backdrop
    opacity: 1

  &__panel
    position: absolute
    top: 0
    right: 0
    display: flex
    flex-direction: column
    width: 100%
    height: 100%
    background-color: $color-white
    color: $color-ink
    box-shadow: $shadow-drawer
    transform: translateX(100%)
    transition: transform $duration-base $ease-out-expo

    +sm()
      width: 420px
      border-radius: $radius-panel 0 0 $radius-panel

    +dark()
      background-color: $color-drawer-dark
      color: $color-mist

  &--open &__panel
    transform: translateX(0)

  &__header
    display: flex
    align-items: center
    justify-content: space-between
    gap: $space-3
    padding: $space-5
    border-bottom: 1px solid rgba($color-navy, .1)

    +sm()
      padding-inline: $space-6

    +dark()
      border-bottom-color: rgba($color-mist, .1)

  &__heading
    display: flex
    align-items: center
    gap: 10px

  &__title
    font-size: 20px
    font-weight: $font-weight-semibold
    letter-spacing: $letter-spacing-tight

  &__count
    flex-center()
    min-width: 24px
    height: 24px
    padding-inline: $space-2
    border-radius: $radius-full
    background-color: rgba($color-sky, .15)
    font-size: 12.5px
    font-weight: $font-weight-bold
    text-accent()

  &__close
    flex-center()
    square(36px)
    border-radius: $radius-full
    color: rgba($color-ink, .7)
    transition: $transition-colors

    &:hover
      background-color: $color-mist
      color: $color-sky

    +dark()
      color: rgba($color-mist, .7)

      &:hover
        background-color: $color-night
        color: $color-sky

    .icon
      square(20px)

  // Contenido intercambiable por AJAX (vacío o líneas + total)
  &__content
    display: flex
    flex: 1
    flex-direction: column
    min-height: 0

  &__empty
    display: flex
    flex: 1
    flex-direction: column
    align-items: center
    justify-content: center
    gap: $space-4
    padding-inline: $space-8
    text-align: center

  &__empty-icon
    flex-center()
    square(64px)
    border-radius: $radius-full
    background-color: $color-mist
    color: $color-sky

    +dark()
      background-color: $color-night

    .icon
      square(28px)

  &__empty-title
    font-size: 17px
    font-weight: $font-weight-semibold

  &__empty-text
    margin-top: $space-1
    font-size: 14px
    text-ink(.6)

  &__explore
    height: 40px
    padding-inline: $space-5
    font-size: 14.5px

  &__list
    flex: 1
    padding: $space-4
    overflow-y: auto
    overscroll-behavior: contain

    +sm()
      padding-inline: $space-5

    > * + *
      margin-top: $space-3

  &__footer
    padding: $space-5
    border-top: 1px solid rgba($color-navy, .1)

    +sm()
      padding-inline: $space-6

    +dark()
      border-top-color: rgba($color-mist, .1)

  &__row
    display: flex
    align-items: center
    justify-content: space-between
    font-size: 14.5px
    text-ink(.7)

    &--total
      align-items: baseline
      margin-top: $space-2
      font-size: inherit
      color: inherit

      +dark()
        color: inherit

  &__total-label
    font-size: 16px
    font-weight: $font-weight-semibold

  &__total
    font-size: 22px
    font-weight: $font-weight-bold
    text-accent()

  &__actions
    display: flex
    flex-direction: column
    gap: 10px
    margin-top: $space-5

  &__checkout,
  &__review
    display: inline-flex
    align-items: center
    justify-content: center
    height: 48px
    border-radius: $radius-full
    font-size: 15.5px
    font-weight: $font-weight-semibold
    transition: $transition-colors

    &:focus
      outline: none

  // Anillo separado del panel
  &__checkout
    gap: $space-2
    background-color: $color-navy
    color: $color-white
    box-shadow: $shadow-sm

    &:hover
      background-color: $color-sky

    &:focus-visible
      box-shadow: 0 0 0 2px $color-white, 0 0 0 4px $color-sky

    +dark()
      &:focus-visible
        box-shadow: 0 0 0 2px $color-night, 0 0 0 4px $color-sky

    .icon
      square(16px)

  &__review
    border: 1px solid rgba($color-navy, .25)
    color: $color-navy

    &:hover
      background-color: rgba($color-navy, .05)

    &:focus-visible
      ring($color-sky)

    +dark()
      border-color: rgba($color-mist, .2)
      color: $color-mist

      &:hover
        background-color: rgba($color-mist, .05)

// Línea del carrito
.cart-item
  display: flex
  gap: 14px
  padding: $space-3
  border-radius: $radius-2xl
  background-color: rgba($color-mist, .7)

  +dark()
    background-color: rgba($color-night, .6)

  &__image
    flex-shrink: 0
    square(80px)
    border-radius: $radius-xl
    object-fit: cover
    background-color: rgba($color-navy, .1)

  &__body
    display: flex
    flex: 1
    flex-direction: column
    min-width: 0

  &__top
    display: flex
    align-items: flex-start
    justify-content: space-between
    gap: $space-2

  &__title
    line-clamp(2)
    font-size: 14.5px
    font-weight: $font-weight-semibold
    line-height: $line-height-snug
    color: $color-ink
    transition: $transition-colors

    &:hover
      color: $color-sky

    +dark()
      color: $color-mist

      &:hover
        color: $color-sky

  &__remove
    flex-center()
    flex-shrink: 0
    square(32px)
    margin-top: -4px
    margin-right: -4px
    border-radius: $radius-full
    color: rgba($color-ink, .5)
    transition: $transition-colors

    &:hover
      background-color: $color-red-50
      color: $color-red-600

    +dark()
      color: rgba($color-mist, .5)

      &:hover
        background-color: rgba($color-red-950, .3)
        color: $color-red-400

  &__format
    margin-top: 2px
    font-size: 13px
    text-ink(.6)

  &__bottom
    display: flex
    align-items: center
    justify-content: space-between
    gap: $space-2
    margin-top: auto
    padding-top: $space-2

  &__quantity
    padding: 2px 10px
    border-radius: $radius-full
    background-color: $color-white
    font-size: 12.5px
    font-weight: $font-weight-semibold
    text-ink(.75)

    +dark()
      background-color: $color-surface-dark

  &__subtotal
    font-size: 15px
    font-weight: $font-weight-bold
    text-accent()
