// Loadable (bloque: loadable): carga simulada con skeleton
// Estados:
// - html.js sin --ready: skeleton inicial (sin JS se ve el contenido)
// - --loading: skeleton tras aplicar una búsqueda
// - --typing: resultados atenuados mientras se escribe

.loadable
  &__skeleton,
  &__loading-text
    display: none

  &__content
    transition: opacity $transition-base

  &--typing &__content
    opacity: .6

html.js .loadable:not(.loadable--ready),
.loadable--loading
  .loadable__skeleton
    display: block

  .loadable__loading-text
    display: inline

  .loadable__content,
  .loadable__ready-text
    display: none
