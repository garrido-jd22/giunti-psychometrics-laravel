// Botones (bloques: button, icon-button), avatar y bloques de skeleton
// Nota: `html.dark .x` tiene más especificidad que `.x:hover`; si el hover
// debe aplicarse también en oscuro, se repite dentro de +dark().

// Button
.button
  display: inline-flex
  align-items: center
  justify-content: center
  flex-shrink: 0
  gap: 6px
  border-radius: $radius-full
  font-weight: $font-weight-semibold
  transition: $transition-colors

  .icon
    square(16px)

  &--primary
    background-color: $color-navy
    color: $color-white

    &:hover
      background-color: $color-sky

  &--press
    transition: background-color $transition-base, scale $transition-base

    &:active
      scale: .97

  &--pill
    gap: 6px
    height: 40px
    padding-inline: $space-4
    font-size: 14px

  &--icon
    square(36px)

  &--block
    width: 100%
    gap: $space-2
    height: 48px
    padding-inline: $space-6
    font-size: 15.5px
    box-shadow: $shadow-sm

  // Con círculo de flecha a la derecha
  &--arrow
    gap: $space-3
    height: 44px
    padding-left: $space-6
    padding-right: $space-2
    box-shadow: $shadow-sm

  &__arrow
    flex-center()
    square(28px)
    border-radius: $radius-full
    background-color: rgba($color-white, .15)

    .icon
      square(14px)

  .icon.button__icon--sm
    square(14px)

// Icon button (tema, carrito, menú, buscar)
.icon-button
  position: relative
  flex-center()
  square(36px)
  border-radius: $radius-full
  border: 1px solid rgba($color-navy, .25)
  color: $color-ink
  transition: $transition-colors

  &:hover
    border-color: $color-sky
    color: $color-sky

  +dark()
    border-color: rgba($color-mist, .25)
    color: $color-mist

    &:hover
      border-color: $color-sky
      color: $color-sky

  .icon
    square(16px)

// Avatar con iniciales
.avatar
  flex-center()
  flex-shrink: 0
  square(32px)
  border-radius: $radius-full
  background-color: rgba($color-navy, .15)
  color: $color-navy
  font-size: 12px
  font-weight: $font-weight-bold

  +dark()
    background-color: rgba($color-sky, .2)
    color: $color-sky

  &--sm
    square(24px)
    font-size: 10.5px

// Skeleton
.skeleton-block
  display: block
  border-radius: $radius-full
  background-color: rgba($color-navy, .1)

  +dark()
    background-color: rgba($color-mist, .1)

  &--soft
    border-radius: $radius-xl
