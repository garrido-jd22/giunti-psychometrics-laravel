// ==========================================================================
// Formularios (bloques: form-field, field-control)
// ==========================================================================

.form-field
  &__label
    display: block
    margin-bottom: $space-2
    font-size: 14px
    font-weight: $font-weight-semibold
    text-ink()

  &__required
    margin-left: 2px
    color: $color-sky

  &__optional
    margin-left: 6px
    font-weight: $font-weight-regular
    text-ink(.5)

  &__error
    display: flex
    align-items: flex-start
    gap: 6px
    margin-top: 6px
    font-size: 13.5px
    font-weight: $font-weight-medium
    color: $color-red-600

    +dark()
      color: $color-red-400

  .icon.form-field__error-icon
    square(16px)
    margin-top: 1px

  &__hint
    margin-top: 6px
    font-size: 13px
    text-ink(.55)

// rounded-2xl text-[15px] bg-[#EFF6FF]/70 focus:ring-2
.field-control
  width: 100%
  height: 44px
  padding-inline: $space-4
  border-radius: $radius-2xl
  background-color: rgba($color-mist, .7)
  color: $color-ink
  font-size: 15px
  transition: all $transition-base

  &::placeholder
    color: rgba($color-ink, .45)

  &:focus
    outline: none
    ring($color-sky)

  +dark()
    background-color: rgba($color-night, .75)
    color: $color-mist

    &::placeholder
      color: rgba($color-mist, .45)

  &--textarea
    height: auto
    padding: $space-4
    resize: none

  // Con error: anillo rojo y fondo rosado
  &--error
    background-color: rgba($color-red-50, .6)
    ring(rgba($color-red-500, .7))

    &:focus
      ring($color-red-500)

    +dark()
      background-color: rgba($color-red-950, .2)
