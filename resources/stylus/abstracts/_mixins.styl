// Mixins

// Media queries (mobile first)
sm()
  @media (min-width: $bp-sm)
    {block}

md()
  @media (min-width: $bp-md)
    {block}

lg()
  @media (min-width: $bp-lg)
    {block}

xl()
  @media (min-width: $bp-xl)
    {block}

// Alias semánticos: tablet = md (768px), desktop = xl (1280px)
tablet()
  @media (min-width: $bp-tablet)
    {block}

desktop()
  @media (min-width: $bp-desktop)
    {block}

mobile-only()
  @media (max-width: ($bp-tablet - 1))
    {block}

// Tema oscuro (clase .dark en <html>)
dark()
  html.dark &
    {block}

// Colores de texto con su pareja en tema oscuro

text-ink($alpha = 1)
  color: rgba($color-ink, $alpha)
  +dark()
    color: rgba($color-mist, $alpha)

text-accent()
  color: $color-navy
  +dark()
    color: $color-sky

// Fondo y texto de sección
surface-section()
  background-color: $color-mist
  color: $color-ink
  transition: background-color $duration-base $ease-default, color $duration-base $ease-default
  +dark()
    background-color: $color-night
    color: $color-mist

// Tarjeta translúcida
glass-card($alpha = .8, $alpha-dark = .85)
  glass($color-white, $alpha)
  +dark()
    background-color: rgba($color-surface-dark, $alpha-dark)

square($size)
  width: $size
  height: $size

// Preferencia de movimiento reducido del usuario
motion-safe()
  @media (prefers-reduced-motion: no-preference)
    {block}

motion-reduce()
  @media (prefers-reduced-motion: reduce)
    {block}

// Utilidades de maquetación

flex-center()
  display: flex
  align-items: center
  justify-content: center

truncate()
  overflow: hidden
  white-space: nowrap
  text-overflow: ellipsis

line-clamp($lines)
  display: -webkit-box
  -webkit-box-orient: vertical
  -webkit-line-clamp: $lines
  line-clamp: $lines
  overflow: hidden

// Oculto visualmente, accesible para lectores de pantalla
visually-hidden()
  position: absolute
  width: 1px
  height: 1px
  padding: 0
  margin: -1px
  overflow: hidden
  clip: rect(0, 0, 0, 0)
  white-space: nowrap
  border: 0

glass($color, $alpha, $blur = 12px)
  background-color: rgba($color, $alpha)
  -webkit-backdrop-filter: blur($blur)
  backdrop-filter: blur($blur)

// Anillo con box-shadow (sustituye a cualquier otra sombra)
ring($color, $width = 2px)
  box-shadow: 0 0 0 $width $color

animation-delay($ms)
  +motion-safe()
    animation-delay: $ms
