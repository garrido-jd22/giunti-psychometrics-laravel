// ==========================================================================
// Variables
// Valores tomados de las clases Tailwind del proyecto Next.js original.
// ==========================================================================

// --------------------------------------------------------------------------
// Colores de marca
// --------------------------------------------------------------------------
$color-navy = #1B4F8A          // Primario: botones, enlaces, acentos
$color-sky = #0EA5E9           // Acento: hover, iconos, foco
$color-ink = #0F2D52           // Texto principal (tema claro)
$color-mist = #EFF6FF          // Fondo de secciones (claro) / texto (oscuro)
$color-night = #091526         // Fondo de secciones (oscuro)
$color-surface-dark = #11223A  // Tarjetas y superficies (oscuro)
$color-drawer-dark = #0D1B2F   // Panel del carrito (oscuro)
$color-white = #ffffff
$color-black = #000000

// Fondo y texto del <body> (globals.css)
$color-background-light = #ffffff
$color-foreground-light = #171717
$color-background-dark = #0a0a0a
$color-foreground-dark = #ededed

// --------------------------------------------------------------------------
// Paleta Tailwind usada en estados (error, éxito, avisos, toasts)
// --------------------------------------------------------------------------
$color-red-50 = #fef2f2
$color-red-300 = #fca5a5
$color-red-400 = #f87171
$color-red-500 = #ef4444
$color-red-600 = #dc2626
$color-red-950 = #450a0a

$color-emerald-50 = #ecfdf5
$color-emerald-100 = #d1fae5
$color-emerald-300 = #6ee7b7
$color-emerald-400 = #34d399
$color-emerald-500 = #10b981
$color-emerald-600 = #059669
$color-emerald-700 = #047857
$color-emerald-950 = #022c22

$color-amber-50 = #fffbeb
$color-amber-300 = #fcd34d
$color-amber-400 = #fbbf24
$color-amber-500 = #f59e0b
$color-amber-600 = #d97706
$color-amber-950 = #451a03

$color-sky-50 = #f0f9ff
$color-sky-300 = #7dd3fc
$color-sky-400 = #38bdf8
$color-sky-500 = #0ea5e9
$color-sky-600 = #0284c7
$color-sky-950 = #082f49

$color-slate-100 = #f1f5f9
$color-slate-300 = #cbd5e1
$color-slate-400 = #94a3b8
$color-slate-500 = #64748b
$color-slate-600 = #475569
$color-slate-900 = #0f172a

$color-gray-100 = #f3f4f6
$color-gray-700 = #374151

// --------------------------------------------------------------------------
// Tipografía
// --------------------------------------------------------------------------
$font-family-base = 'Inter', ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji'
$font-size-base = 16px
$font-weight-light = 300
$font-weight-regular = 400
$font-weight-medium = 500
$font-weight-semibold = 600
$font-weight-bold = 700
$line-height-base = 1.5
$line-height-snug = 1.375
$line-height-relaxed = 1.625
$letter-spacing-tight = -0.025em
$letter-spacing-tighter = -0.03em
$letter-spacing-wide = 0.025em

// --------------------------------------------------------------------------
// Breakpoints (mismos que Tailwind; mobile first)
// --------------------------------------------------------------------------
$bp-mobile = 375px   // Ancho de referencia mínimo
$bp-sm = 640px
$bp-md = 768px       // Tablet
$bp-lg = 1024px      // Navegación de escritorio
$bp-xl = 1280px      // Desktop
$bp-tablet = $bp-md
$bp-desktop = $bp-xl

// --------------------------------------------------------------------------
// Layout
// --------------------------------------------------------------------------
$container-max-width = 1220px
$container-gutter = 16px      // px-4
$container-gutter-sm = 24px   // sm:px-6
$header-offset = 96px         // scroll-mt-24: compensa el header fijo

// --------------------------------------------------------------------------
// Espaciado (escala de Tailwind: 1 = 4px)
// --------------------------------------------------------------------------
$space-1 = 4px
$space-2 = 8px
$space-3 = 12px
$space-4 = 16px
$space-5 = 20px
$space-6 = 24px
$space-8 = 32px
$space-10 = 40px
$space-12 = 48px
$space-16 = 64px
$space-20 = 80px

// --------------------------------------------------------------------------
// Bordes
// --------------------------------------------------------------------------
$radius-md = 6px
$radius-lg = 8px
$radius-xl = 12px
$radius-2xl = 16px
$radius-3xl = 24px
$radius-card-image = 18px
$radius-card = 24px
$radius-panel = 28px
$radius-hero = 30px
$radius-full = 9999px

// --------------------------------------------------------------------------
// Sombras
// --------------------------------------------------------------------------
$shadow-xs = 0 1px 2px 0 rgba($color-black, .05)
$shadow-sm = 0 1px 3px 0 rgba($color-black, .1), 0 1px 2px -1px rgba($color-black, .1)
$shadow-card = 0 8px 30px rgba($color-ink, .05)
$shadow-card-dark = 0 8px 30px rgba($color-black, .25)
$shadow-card-hover = 0 14px 38px rgba($color-navy, .12)
$shadow-panel = 0 10px 35px rgba($color-ink, .06)
$shadow-panel-dark = 0 10px 35px rgba($color-black, .3)
$shadow-popover = 0 18px 45px rgba($color-ink, .18)
$shadow-popover-dark = 0 18px 45px rgba($color-black, .45)
$shadow-purchase = 0 10px 35px rgba($color-ink, .08)
$shadow-feature = 0 12px 35px rgba($color-ink, .10)
$shadow-feature-dark = 0 12px 35px rgba($color-black, .35)
$shadow-feature-hover = 0 18px 40px rgba($color-navy, .18)
$shadow-resources = 0 12px 40px rgba($color-ink, .06)
$shadow-resources-dark = 0 12px 40px rgba($color-black, .3)
$shadow-listbox = 0 18px 45px rgba($color-ink, .16)
$shadow-drawer = -20px 0 50px rgba($color-ink, .18)
$shadow-toast = 0 12px 32px rgba($color-ink, .16)
$shadow-toast-dark = 0 12px 32px rgba($color-black, .45)

// --------------------------------------------------------------------------
// Transiciones y animaciones
// --------------------------------------------------------------------------
$ease-default = cubic-bezier(.4, 0, .2, 1)     // Transición por defecto de Tailwind
$ease-out-expo = cubic-bezier(.22, 1, .36, 1)  // Entradas, dropdown, drawer
$ease-toast = cubic-bezier(.21, 1.02, .73, 1)
$duration-fast = 150ms
$duration-base = 300ms
$duration-slow = 500ms
$transition-colors = color $duration-fast $ease-default, background-color $duration-fast $ease-default, border-color $duration-fast $ease-default
$transition-base = $duration-fast $ease-default

// --------------------------------------------------------------------------
// Capas (usar con la función z())
// --------------------------------------------------------------------------
$z-layers = {
  base: 1,
  raised: 10,
  overlap: 20,
  dropdown: 30,
  header: 50,
  drawer: 60,
  toast: 100
}
