// Footer (bloque: footer)

.footer
  width: 100%
  surface-section()
  border-top: 1px solid rgba($color-navy, .1)

  +dark()
    border-top-color: rgba($color-mist, .1)

  &__inner
    max-width: $container-max-width
    margin-inline: auto
    padding: $space-16 $space-6 $space-10

  &__grid
    display: grid
    grid-template-columns: minmax(0, 1fr)
    gap: $space-10
    padding-bottom: $space-16

    +sm()
      grid-template-columns: repeat(2, minmax(0, 1fr))

    +lg()
      grid-template-columns: repeat(12, minmax(0, 1fr))
      gap: $space-6

  &__brand
    display: flex
    flex-direction: column
    align-items: flex-start

    +lg()
      grid-column: span 3

  // Degradado de marca recortado al texto
  &__tagline
    margin-top: $space-4
    font-size: 20px
    font-weight: $font-weight-bold
    letter-spacing: $letter-spacing-tight
    line-height: 1.25
    background-image: linear-gradient(to right, $color-navy, $color-sky)
    -webkit-background-clip: text
    background-clip: text
    color: transparent

    +sm()
      font-size: 22px

    +dark()
      background-image: linear-gradient(to right, $color-mist, $color-sky)

  &__column
    +lg()
      grid-column: span 2

    &--4
      +lg()
        grid-column: span 1

  &__title
    margin-bottom: $space-4
    font-size: 15px
    font-weight: $font-weight-semibold
    text-ink()

  &__links > * + *
    margin-top: $space-3

  &__link
    font-size: 14.5px
    text-ink(.75)
    transition: $transition-colors

    &:hover
      color: $color-sky

    +dark()
      &:hover
        color: $color-sky

  // Columnas 2 y 4 (textos largos): enlaces en bloque
  &__column--2 &__link,
  &__column--4 &__link
    display: block
    line-height: $line-height-snug

  &__aside
    display: flex
    flex-direction: column
    align-items: flex-start
    justify-content: flex-start
    gap: $space-5

    +lg()
      grid-column: span 2
      align-items: flex-end

  &__social
    display: flex
    align-items: center
    gap: $space-4
    text-ink(.7)

  &__social-link
    transition: $transition-colors

    &:hover
      color: $color-sky

    +dark()
      &:hover
        color: $color-sky

  &__social-icon
    square(17px)
    fill: currentColor

    &--wide
      square(19px)

  &__contact
    display: inline-flex
    align-items: center
    justify-content: center
    padding: 10px $space-6
    border-radius: $radius-lg
    background-color: rgba($color-navy, .1)
    color: $color-navy
    font-size: 15px
    font-weight: $font-weight-medium
    transition: $transition-colors

    &:hover
      background-color: $color-navy
      color: $color-white

    +dark()
      background-color: $color-surface-dark
      color: $color-mist

      &:hover
        background-color: $color-sky
        color: $color-white

  &__divider
    border-top: 1px solid rgba($color-navy, .15)

    +dark()
      border-top-color: rgba($color-mist, .15)

  &__bottom
    display: flex
    flex-direction: column
    align-items: flex-start
    justify-content: space-between
    gap: $space-4
    padding-top: 28px
    font-size: 13px
    color: rgba($color-ink, .65)

    +lg()
      flex-direction: row
      align-items: center

    +dark()
      color: rgba($color-mist, .55)

  &__legal > * + *
    margin-top: $space-1

  &__mail
    text-underline-offset: 2px
    transition: $transition-colors

    &:hover
      color: $color-sky
      text-decoration: underline

  &__policies
    display: flex
    align-items: center
    flex-shrink: 0
    gap: $space-6

  &__policy
    transition: $transition-colors

    &:hover
      color: $color-sky
