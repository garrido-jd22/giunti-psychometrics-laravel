// ==========================================================================
// Tipografía
// Como en el preflight de Tailwind, los encabezados heredan tamaño y peso:
// cada bloque BEM define su propia escala tipográfica.
// ==========================================================================

html
  font-size: $font-size-base
  font-family: $font-family-base

body
  font-family: $font-family-base
  font-weight: $font-weight-regular
  line-height: inherit

h1, h2, h3, h4, h5, h6
  font-size: inherit
  font-weight: inherit
