// Global

html
  color-scheme: light

  &.dark
    color-scheme: dark

.body
  background-color: $color-background-light
  color: $color-foreground-light

  +dark()
    background-color: $color-background-dark
    color: $color-foreground-dark

  // Drawer o menú abiertos: bloquea el scroll del documento
  &--locked
    overflow: hidden
