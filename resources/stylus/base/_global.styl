// ==========================================================================
// Global: colores del documento y estado de la página
// ==========================================================================

html
  color-scheme: light

  &.dark
    color-scheme: dark

// Flujo de bloque normal, como el <body> del original (sin footer "pegajoso")
.body
  background-color: $color-background-light
  color: $color-foreground-light

  +dark()
    background-color: $color-background-dark
    color: $color-foreground-dark

  // Drawer o menú abiertos: bloquea el scroll del documento
  &--locked
    overflow: hidden
