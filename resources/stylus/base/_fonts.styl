// ==========================================================================
// Fuentes: Inter variable (100–900), normal e itálica
// Los archivos viven en resources/fonts y Vite los versiona en el build.
// ==========================================================================

@font-face
  font-family: 'Inter'
  font-style: normal
  font-weight: 100 900
  font-display: swap
  src: url('../fonts/Inter/Inter-Variable.ttf') format('truetype')

@font-face
  font-family: 'Inter'
  font-style: italic
  font-weight: 100 900
  font-display: swap
  src: url('../fonts/Inter/Inter-Italic-Variable.ttf') format('truetype')
